meta {
  name: Signup
  type: graphql
  seq: 1
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation Signup($input: SignupInput!) {
    signup(input: $input) {
    success
    message
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "user@example.com",
      "password": "strongpassword",
      "first_name": "New",
      "last_name": "User",
      "phone": "1234567890",
      "role": "DOCTOR"
    }
  }
}
